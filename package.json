{
  "name": "skylily-doc-gen",
  "version": "0.2.0",
  "description": "Generate comprehensive documentation from any TypeScript/JavaScript codebase. Fast, configurable, and TypeScript-first.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "types": "./dist/errors.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "bin": {
    "doc-gen": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "clean": "rm -rf dist coverage",
    "docs": "node dist/cli.js ./src --single API.md --title 'doc-gen API'"
  },
  "keywords": [
    "documentation",
    "docs",
    "generator",
    "typescript",
    "javascript",
    "jsdoc",
    "api",
    "markdown",
    "typedoc",
    "autodoc",
    "code-documentation",
    "doc-gen",
    "skylily",
    "cli",
    "parser",
    "ast"
  ],
  "author": {
    "name": "Skylily",
    "url": "https://github.com/pkmdev-sec"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkmdev-sec/skylily-doc-gen.git"
  },
  "bugs": {
    "url": "https://github.com/pkmdev-sec/skylily-doc-gen/issues"
  },
  "homepage": "https://github.com/pkmdev-sec/skylily-doc-gen#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@vitest/coverage-v8": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
